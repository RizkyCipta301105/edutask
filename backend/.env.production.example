# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=ganti-dengan-secret-key-panjang-minimal-50-karakter
DEBUG=False
ALLOWED_HOSTS=your-app.up.railway.app,your-custom-domain.com

# ─── Security (aktifkan saat production) ──────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# ─── Database (Supabase) ───────────────────────────────────────────────────────
# Ambil dari: Supabase → Settings → Database → Connection string (URI)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ─── KlikQRIS ─────────────────────────────────────────────────────────────────
KLIKQRIS_API_KEY=your-klikqris-api-key
KLIKQRIS_MERCHANT_ID=your-merchant-id

# ─── URLs ─────────────────────────────────────────────────────────────────────
# Backend URL Railway (isi setelah deploy)
EDUTASK_BASE_URL=https://your-app.up.railway.app
# Frontend URL Vercel (isi setelah deploy frontend)
EDUTASK_FRONTEND_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
